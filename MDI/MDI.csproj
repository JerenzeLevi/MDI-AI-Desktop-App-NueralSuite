      <OnnxNativeSrc Condition="'$(PlatformTarget)' != 'x86'">..\packages\Microsoft.ML.OnnxRuntime.1.19.2\runtimes\win-x64\native\</OnnxNativeSrc>
    </PropertyGroup>
    <Copy SourceFiles="$(OnnxNativeSrc)onnxruntime.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OnnxNativeSrc)onnxruntime_providers_shared.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
